<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQL Database Script Generator</title>
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar px-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 text-primary"><i class="bi bi-database-fill-gear"></i></span>
                    <span class="brand-badge fs-5">SQL Script Studio</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">

                    <div class="d-flex align-items-center gap-2">
                        <!-- AI Engine Configuration Trigger Button -->
                        <button type="button" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#aiConfigModal" onclick="loadAiConfig()">
                            <i class="bi bi-lightning-charge-fill"></i> <span id="navAiProviderBadge">AI: Groq Cloud</span>
                        </button>

                        <!-- Live DB Inspector Trigger Button -->
                        <button type="button" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#liveDbModal">
                            <i class="bi bi-hdd-network"></i> Connect Live DB
                        </button>

                        <!-- Corporate Policy / RAG Trigger Button -->
                        <button type="button" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#standardsModal" onclick="loadCorporateStandards()">
                            <i class="bi bi-sliders"></i> Corporate Policy
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="dashboard-container">
        @RenderBody()
    </div>

    <!-- Modal 1: Live DB Inspector -->
    <div class="modal fade" id="liveDbModal" tabindex="-1" aria-labelledby="liveDbModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info" id="liveDbModalLabel"><i class="bi bi-hdd-network me-2"></i> Inspect Live Database Schema</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="liveDbConnString" class="form-label text-light">SQL Server Connection String (Read-Only)</label>
                        <input type="text" class="form-control form-control-custom" id="liveDbConnString" 
                               placeholder="Server=localhost;Database=MyDb;Trusted_Connection=True;TrustServerCertificate=True;" />
                    </div>
                    <button type="button" class="btn btn-info btn-sm" id="btnInspectLiveTables" onclick="inspectLiveDbTables()">
                        <i class="bi bi-search"></i> Inspect Tables
                    </button>

                    <div id="liveDbTablesContainer" class="mt-3" style="display: none;">
                        <label class="form-label text-light">Select Table to Load into Editor:</label>
                        <div class="input-group">
                            <select id="liveDbTableSelect" class="form-select form-select-custom"></select>
                            <button type="button" class="btn btn-primary" onclick="loadSelectedLiveTableDdl()">
                                <i class="bi bi-box-arrow-in-down"></i> Load DDL
                            </button>
                        </div>
                    </div>
                    <div id="liveDbStatusMsg" class="mt-2 text-warning" style="font-size: 0.85rem;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2: Corporate Standards & RAG Policy -->
    <div class="modal fade" id="standardsModal" tabindex="-1" aria-labelledby="standardsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning" id="standardsModalLabel"><i class="bi bi-sliders me-2"></i> Corporate SQL Standards (RAG Policy)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Stored Procedure Prefix</label>
                            <input type="text" class="form-control form-control-custom" id="stdSpPrefix" value="usp_" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Index Prefix</label>
                            <input type="text" class="form-control form-control-custom" id="stdIndexPrefix" value="IX_" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Created At Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdCreatedAt" value="CreatedAtUtc" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Soft Delete Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdSoftDelete" value="IsDeleted" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Created By Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdCreatedBy" value="CreatedBy" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Optimistic Concurrency</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="stdConcurrency" checked>
                                <label class="form-check-label text-light" for="stdConcurrency">Include [RowVersion]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-warning btn-sm" onclick="saveCorporateStandards()">
                        <i class="bi bi-check2-circle"></i> Save Policy
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: Groq Cloud AI Configuration -->
    <div class="modal fade" id="aiConfigModal" tabindex="-1" aria-labelledby="aiConfigModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning" id="aiConfigModalLabel"><i class="bi bi-lightning-charge me-2"></i> Groq Cloud AI Configuration</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small mb-3">
                        Powered by <strong>Groq LPU + Llama 3.3 70B</strong>. Generates instant, production-grade SQL from Hindi, Hinglish, and English without any local Ollama download.
                    </p>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label text-light fw-bold small mb-0">Groq API Key</label>
                                <a href="https://console.groq.com/keys" target="_blank" class="small text-warning text-decoration-none">
                                    <i class="bi bi-box-arrow-up-right"></i> Get Free Groq API Key
                                </a>
                            </div>
                            <input type="password" class="form-control form-control-custom" id="cfgGroqKey" placeholder="gsk_..." />
                            <div class="form-text text-secondary" style="font-size: 0.75rem;">Key is stored safely in-memory for your active session.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-light fw-bold small">AI Model</label>
                            <input type="text" class="form-control form-control-custom" id="cfgGroqModel" value="llama-3.3-70b-versatile" readonly style="opacity: 0.85;" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="cfgEnableAi" checked>
                                <label class="form-check-label text-light small" for="cfgEnableAi">Enable Groq AI Generation &amp; Tuning</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="cfgFallbackAst" checked>
                                <label class="form-check-label text-secondary small" for="cfgFallbackAst">
                                    Offline AST Fallback (Generate SQL via local parser if internet is down)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-warning btn-sm" onclick="saveAiConfig()">
                        <i class="bi bi-check2-circle"></i> Save Groq Key
                    </button>
                </div>
            </div>
        </div>
    </div>

    <footer class="app-footer text-center">
        <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong>SQL Database Script Generator</strong> | Built with ASP.NET Core, ScriptDom &amp; Groq Cloud AI
            </div>
            <div class="text-muted mt-2 mt-md-0">
                <span><i class="bi bi-cpu me-1"></i> T-SQL 160 AST Engine</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Mermaid.js for Schema ER Diagram -->
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({ startOnLoad: false, theme: 'dark' });
    </script>

    <!-- SweetAlert2 for modern UI notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Monaco Editor Loader via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
    <script src="~/js/sql-generator.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
