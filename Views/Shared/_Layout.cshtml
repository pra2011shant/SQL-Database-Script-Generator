<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQL Database Script Generator</title>
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar px-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 text-primary"><i class="bi bi-database-fill-gear"></i></span>
                    <span class="brand-badge fs-5">SQL Script Studio</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarContent">

                    <div class="d-flex align-items-center gap-2">
                        <!-- AI Engine Configuration Trigger Button -->
                        <button type="button" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#aiConfigModal" onclick="loadAiConfig()">
                            <i class="bi bi-robot"></i> <span id="navAiProviderBadge">AI: Gemini</span>
                        </button>

                        <!-- Live DB Inspector Trigger Button -->
                        <button type="button" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#liveDbModal">
                            <i class="bi bi-hdd-network"></i> Connect Live DB
                        </button>

                        <!-- Corporate Policy / RAG Trigger Button -->
                        <button type="button" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#standardsModal" onclick="loadCorporateStandards()">
                            <i class="bi bi-sliders"></i> Corporate Policy
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="dashboard-container">
        @RenderBody()
    </div>

    <!-- Modal 1: Live DB Inspector -->
    <div class="modal fade" id="liveDbModal" tabindex="-1" aria-labelledby="liveDbModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info" id="liveDbModalLabel"><i class="bi bi-hdd-network me-2"></i> Inspect Live Database Schema</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="liveDbConnString" class="form-label text-light">SQL Server Connection String (Read-Only)</label>
                        <input type="text" class="form-control form-control-custom" id="liveDbConnString" 
                               placeholder="Server=localhost;Database=MyDb;Trusted_Connection=True;TrustServerCertificate=True;" />
                    </div>
                    <button type="button" class="btn btn-info btn-sm" id="btnInspectLiveTables" onclick="inspectLiveDbTables()">
                        <i class="bi bi-search"></i> Inspect Tables
                    </button>

                    <div id="liveDbTablesContainer" class="mt-3" style="display: none;">
                        <label class="form-label text-light">Select Table to Load into Editor:</label>
                        <div class="input-group">
                            <select id="liveDbTableSelect" class="form-select form-select-custom"></select>
                            <button type="button" class="btn btn-primary" onclick="loadSelectedLiveTableDdl()">
                                <i class="bi bi-box-arrow-in-down"></i> Load DDL
                            </button>
                        </div>
                    </div>
                    <div id="liveDbStatusMsg" class="mt-2 text-warning" style="font-size: 0.85rem;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2: Corporate Standards & RAG Policy -->
    <div class="modal fade" id="standardsModal" tabindex="-1" aria-labelledby="standardsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning" id="standardsModalLabel"><i class="bi bi-sliders me-2"></i> Corporate SQL Standards (RAG Policy)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Stored Procedure Prefix</label>
                            <input type="text" class="form-control form-control-custom" id="stdSpPrefix" value="usp_" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Index Prefix</label>
                            <input type="text" class="form-control form-control-custom" id="stdIndexPrefix" value="IX_" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Created At Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdCreatedAt" value="CreatedAtUtc" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Soft Delete Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdSoftDelete" value="IsDeleted" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Created By Column</label>
                            <input type="text" class="form-control form-control-custom" id="stdCreatedBy" value="CreatedBy" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-secondary" style="font-size: 0.8rem;">Optimistic Concurrency</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="stdConcurrency" checked>
                                <label class="form-check-label text-light" for="stdConcurrency">Include [RowVersion]</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-warning btn-sm" onclick="saveCorporateStandards()">
                        <i class="bi bi-check2-circle"></i> Save Policy
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: AI Configuration & Cloud Providers -->
    <div class="modal fade" id="aiConfigModal" tabindex="-1" aria-labelledby="aiConfigModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-success" id="aiConfigModalLabel"><i class="bi bi-robot me-2"></i> AI Provider &amp; Cloud Settings</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small mb-3">
                        Choose your preferred AI Engine. With Cloud AI (Google Gemini / Groq), you can generate SQL from Hindi, Hinglish, or English without running local Ollama models.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-light fw-bold" style="font-size: 0.85rem;">Active AI Engine</label>
                            <select id="cfgAiProvider" class="form-select form-select-custom" onchange="toggleAiProviderFields()">
                                <option value="Gemini">🌐 Google Gemini (Free Cloud AI)</option>
                                <option value="Groq">⚡ Groq Cloud (Llama 3.3 70B)</option>
                                <option value="Ollama">💻 Local Ollama (Offline LLM)</option>
                                <option value="Offline">🛡️ Offline AST Only (No AI)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-light fw-bold" style="font-size: 0.85rem;">Enable AI Enhancement</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="cfgEnableAi" checked>
                                <label class="form-check-label text-secondary small" for="cfgEnableAi">Allow AI prompt generation &amp; tuning</label>
                            </div>
                        </div>

                        <!-- Gemini Section -->
                        <div class="col-12 ai-provider-section" id="sectionGemini">
                            <div class="p-3 rounded border border-success-subtle bg-black bg-opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-success fw-bold"><i class="bi bi-google me-1"></i> Google Gemini Configuration</span>
                                    <a href="https://aistudio.google.com/app/apikey" target="_blank" class="small text-info text-decoration-none">
                                        <i class="bi bi-box-arrow-up-right"></i> Get Free Gemini API Key
                                    </a>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <label class="form-label text-secondary small">Gemini API Key</label>
                                        <input type="password" class="form-control form-control-custom" id="cfgGeminiKey" placeholder="AIzaSy..." />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary small">Model</label>
                                        <input type="text" class="form-control form-control-custom" id="cfgGeminiModel" value="gemini-1.5-flash" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Groq Section -->
                        <div class="col-12 ai-provider-section" id="sectionGroq" style="display:none;">
                            <div class="p-3 rounded border border-warning-subtle bg-black bg-opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-warning fw-bold"><i class="bi bi-lightning-charge me-1"></i> Groq Cloud Configuration</span>
                                    <a href="https://console.groq.com/keys" target="_blank" class="small text-info text-decoration-none">
                                        <i class="bi bi-box-arrow-up-right"></i> Get Free Groq Key
                                    </a>
                                </div>
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <label class="form-label text-secondary small">Groq API Key</label>
                                        <input type="password" class="form-control form-control-custom" id="cfgGroqKey" placeholder="gsk_..." />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary small">Model</label>
                                        <input type="text" class="form-control form-control-custom" id="cfgGroqModel" value="llama-3.3-70b-versatile" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ollama Section -->
                        <div class="col-12 ai-provider-section" id="sectionOllama" style="display:none;">
                            <div class="p-3 rounded border border-info-subtle bg-black bg-opacity-25">
                                <span class="text-info fw-bold mb-2 d-block"><i class="bi bi-hdd-rack me-1"></i> Local Ollama Configuration</span>
                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <label class="form-label text-secondary small">Ollama Base URL</label>
                                        <input type="text" class="form-control form-control-custom" id="cfgOllamaUrl" value="http://localhost:11434" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-secondary small">Local Model Name</label>
                                        <input type="text" class="form-control form-control-custom" id="cfgOllamaModel" value="codellama" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fallback Setting -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="cfgFallbackAst" checked>
                                <label class="form-check-label text-light small" for="cfgFallbackAst">
                                    Automatic Fallback (Try secondary cloud providers &amp; offline AST if API is unavailable)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-success btn-sm" onclick="saveAiConfig()">
                        <i class="bi bi-check2-circle"></i> Save AI Settings
                    </button>
                </div>
            </div>
        </div>
    </div>

    <footer class="app-footer text-center">
        <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong>SQL Database Script Generator</strong> | Built with ASP.NET Core, ScriptDom &amp; Ollama
            </div>
            <div class="text-muted mt-2 mt-md-0">
                <span><i class="bi bi-cpu me-1"></i> T-SQL 160 AST Engine</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Mermaid.js for Schema ER Diagram -->
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <script>
        mermaid.initialize({ startOnLoad: false, theme: 'dark' });
    </script>

    <!-- SweetAlert2 for modern UI notifications -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Monaco Editor Loader via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
    <script src="~/js/sql-generator.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
