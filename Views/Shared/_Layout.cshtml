<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQL Database Script Generator</title>
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar px-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 text-primary"><i class="bi bi-database-fill-gear"></i></span>
                    <span class="brand-badge fs-5">SQL Script Studio</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 px-2 py-1">.NET 8</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-light active" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-terminal-fill me-1 text-primary"></i> Generator Dashboard
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a href="https://github.com/pra2011shant/SQL-Database-Script-Generator" target="_blank" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 border-secondary-subtle text-light">
                            <i class="bi bi-github fs-6"></i> GitHub Repo
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="dashboard-container">
        @RenderBody()
    </div>

    <footer class="app-footer text-center">
        <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center">
            <div>
                &copy; @DateTime.UtcNow.Year - <strong>SQL Database Script Generator</strong> | Built with ASP.NET Core & ScriptDom
            </div>
            <div class="text-muted mt-2 mt-md-0">
                <span><i class="bi bi-cpu me-1"></i> T-SQL 160 AST Engine</span> | 
                <a href="https://github.com/pra2011shant/SQL-Database-Script-Generator" target="_blank" class="text-decoration-none text-muted ms-2">Open Source</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Monaco Editor Loader via CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
    <script src="~/js/sql-generator.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
